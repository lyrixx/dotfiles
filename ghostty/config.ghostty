# The colors of Ptyxis, the terminal before Ghostty. To try others:
# ghostty +list-themes
theme = Monokai Soda

# The monospace font of GNOME, the one of Ptyxis
font-family = Ubuntu Sans Mono
font-size = 11

# Ghostty toggles fullscreen on it: Claude Code inserts a newline with it
keybind = ctrl+enter=unbind

# Over SSH, TERM=xterm-256color: servers do not know xterm-ghostty, Backspace
# and clear break there. No ssh-terminfo: it installs it in the ~/.terminfo of
# the SSH user only, readline breaks after a sudo -sHu
shell-integration-features = ssh-env

# Written by bin/training during a training session, outside this
# repository. Loaded last, it overrides the theme above.
config-file = ?training.ghostty
