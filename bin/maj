#!/bin/bash

# Updates everything at once. Launched by hand only: nothing installed by
# packages/ updates on its own.

set -euo pipefail

NOCOLOR='\e[0m'
TITLECOLOR='\e[1;34m'

function title {
    echo -e "\n$TITLECOLOR==> $1$NOCOLOR"
}

title 'Update apt packages'
sudo apt update
sudo apt upgrade -y

title 'Update deb-get packages'
deb-get update
deb-get upgrade

title 'Update Flatpak apps'
sudo flatpak update -y

title 'Update mise tools'
# --global: run from inside a project, mise would also upgrade the project's tools
mise upgrade --global

title 'Update agent skills'
# mise exec: the PATH of this shell still points to the tools before the upgrade.
# hf-cli is generated from hf: it follows the version just installed
mise exec -- hf skills update hf-cli --global
DISABLE_TELEMETRY=1 mise exec -- skills update --global --yes

title 'Update Rust toolchains'
rustup update

title 'Update composer'
~/.local/bin/composer self-update
