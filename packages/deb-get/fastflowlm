DEFVER=1
get_github_releases "ROCm/FastFlowLM" "latest"
if [ "${ACTION}" != prettylist ]; then
    # One .deb per distribution: fastflowlm_1.0.10_ubuntu26.04_amd64.deb
    URL=$(grep -m 1 "browser_download_url.*/fastflowlm_[^_]*_ubuntu${UPSTREAM_RELEASE}_amd64\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d _ -f 2 <<< "${URL##*/}")
fi
PRETTY_NAME="FastFlowLM"
WEBSITE="https://fastflowlm.com/"
SUMMARY="Runs LLMs on AMD Ryzen AI NPUs."
