<title>{{ report.title }}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
{{ source('style.css') }}
</style>

<div class="page" data-storage-key="{{ report.storageKey }}">
  {{ include('_masthead.html.twig') }}
{% for section in report.sections %}

  <section id="{{ section.id }}" aria-labelledby="{{ section.id }}-title">
    <div class="section-head">
      <h2 id="{{ section.id }}-title">{{ section.title|typo }}</h2>
      {% if section.count is not null %}
        {% if section.type == 'checklist' %}
          <span class="count" data-count="{{ section.group }}" data-format="{{ section.countFormat|typo }}">{{ section.count|typo }}</span>
        {% else %}
          <span class="count">{{ section.count|typo }}</span>
        {% endif %}
      {% endif %}
    </div>
    {% if section.intro %}
      <p class="intro">{{ section.intro|md_inline }}</p>
    {% endif %}
    {{ include('_section_' ~ section.type ~ '.html.twig') }}
  </section>
{% endfor %}
</div>
<script>
{{ source('script.js') }}
</script>
