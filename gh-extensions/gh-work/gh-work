/**
 * Claude Code locks the worktrees it creates, with the process of the session.
 */
final readonly class WorktreeLock
{
    private const string CLAUDE_SESSION = '{^claude session .*\(pid (\d+) start (\d+)\)$}';

    public function __construct(
        public string $reason,
    ) {
    }

    public function isClaudeSession(): bool
    {
        return 1 === preg_match(self::CLAUDE_SESSION, $this->reason);
    }

    /**
     * The session of Claude is over: its lock protects nothing anymore. A lock
     * set by anything else is never stale, since nothing tells.
     */
    public function isStale(): bool
    {
        if (!preg_match(self::CLAUDE_SESSION, $this->reason, $matches)) {
            return false;
        }

        // The process may end between a check and the read: false says it is gone
        $stat = @file_get_contents("/proc/{$matches[1]}/stat");
        if (false === $stat) {
            return true;
        }

        // The start time tells the session from a new process that got its pid.
        // After the name in parentheses, it is the 20th field.
        $fields = explode(' ', substr($stat, (int) strrpos($stat, ')') + 2));

        return ($fields[19] ?? null) !== $matches[2];
    }
}

