final readonly class Snapshot
{
    /**
     * @param list<Entry>        $entries
     * @param list<MergedBranch> $mergedBranches
     */
    private function __construct(
        public array $entries,
        public array $mergedBranches,
        public int $fetchedAt,
    ) {
    }

    /**
     * @param array<string, mixed> $data The response of GitHub
     */
    public static function fromGitHub(array $data, int $fetchedAt): self
    {
        $pullRequests = array_map(Entry::fromPullRequest(...), $data['mine']['nodes']);
        usort($pullRequests, static fn (Entry $a, Entry $b) => [$a->isDraft, $a->ageInDays] <=> [$b->isDraft, $b->ageInDays]);
        $viewerLogin = $data['viewer']['login'];

        return new self(
            [
                ...$pullRequests,
                ...array_map(Entry::fromReviewRequest(...), $data['requested']['nodes']),
                ...array_map(Entry::fromAssignedIssue(...), $data['assignedIssues']['nodes']),
                ...array_map(static fn (array $node) => Entry::fromCreatedIssue($node, $viewerLogin), $data['createdIssues']['nodes']),
                ...array_filter(array_map(static fn (array $node) => Entry::fromMentioningIssue($node, $viewerLogin), $data['mentioningIssues']['nodes'])),
            ],
            array_map(
                static fn (array $node) => new MergedBranch($node['repository']['nameWithOwner'], $node['headRefName'], $node['url']),
                $data['merged']['nodes'],
            ),
            $fetchedAt,
        );
    }
}

