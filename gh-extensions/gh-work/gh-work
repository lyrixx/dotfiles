final readonly class Entry
{
    // Older, a reply is an archive, not someone waiting for me
    private const int AWAITED_REPLY_MAX_AGE_IN_DAYS = 60;

    /**
     * @param list<FailedCheck> $failedChecks
     * @param list<string>      $reviews
     */
    private function __construct(
        public Section $section,
        public string $status,
        public Icon $icon,
        public string $reference,
        public string $agentName,
        public string $title,
        public int $ageInDays,
        public ?string $repository = null,
        public ?string $branch = null,
        public ?string $url = null,
        public ?string $directory = null,
        public ?string $hint = null,
        public ?Inspection $inspection = null,
        public ?LocalBranch $localBranch = null,
        public bool $isDraft = false,
        public array $failedChecks = [],
        public array $reviews = [],
        public int $additions = 0,
        public int $deletions = 0,
        public int $changedFiles = 0,
        public int $unresolvedThreads = 0,
    ) {
    }

    /**
     * @param array<string, mixed> $node
     */
    public static function fromPullRequest(array $node): self
    {
        $rollup = $node['commits']['nodes'][0]['commit']['statusCheckRollup'] ?? null;
        $ci = $rollup['state'] ?? 'NONE';
        $reviews = $node['latestOpinionatedReviews']['nodes'];
        $reviewStates = array_column($reviews, 'state');
        $conflicting = 'CONFLICTING' === $node['mergeable'];
        $changesRequested = \in_array('CHANGES_REQUESTED', $reviewStates, true);
        $ciFailed = \in_array($ci, ['ERROR', 'FAILURE'], true);
        $approved = \in_array('APPROVED', $reviewStates, true);
        $readyToMerge = !$node['isDraft'] && $approved && !$conflicting && !$changesRequested && \in_array($ci, ['NONE', 'SUCCESS'], true);

        $blockers = array_keys(array_filter([
            'CI rouge' => $ciFailed,
            'conflit' => $conflicting,
            'changements demandés' => $changesRequested,
        ]));

        [$section, $status, $icon] = match (true) {
            [] !== $blockers => [Section::ToDo, implode(' + ', $blockers), $ciFailed ? Icon::CiFailed : Icon::Blocked],
            $readyToMerge => [Section::ToDo, 'prêt à merger', Icon::ReadyToMerge],
            default => [Section::Rest, self::waitingStatus($node, $ci), self::waitingIcon($node, $ci)],
        };

        return new self(
            section: $section,
            status: $status,
            icon: $icon,
            reference: "{$node['repository']['nameWithOwner']}#{$node['number']}" . ($node['isDraft'] ? ' (draft)' : ''),
            agentName: self::agentName($node['repository']['nameWithOwner'], (string) $node['number']),
            title: StringUtils::stripControlBytes($node['title']),
            ageInDays: daysSince($node['updatedAt']),
            repository: $node['repository']['nameWithOwner'],
            branch: $node['headRefName'],
            url: $node['url'],
            isDraft: $node['isDraft'],
            failedChecks: FailedCheck::fromRollup($rollup),
            reviews: array_map(self::renderReview(...), $reviews),
            additions: $node['additions'],
            deletions: $node['deletions'],
            changedFiles: $node['changedFiles'],
            unresolvedThreads: \count(array_filter($node['reviewThreads']['nodes'], static fn (array $thread) => !$thread['isResolved'])),
        );
    }

    /**
     * @param array<string, mixed> $node
     */
    public static function fromReviewRequest(array $node): self
    {
        return new self(
            section: Section::Reviews,
            status: "@{$node['author']['login']}",
            icon: Icon::ReviewRequested,
            reference: "{$node['repository']['nameWithOwner']}#{$node['number']}",
            agentName: self::agentName($node['repository']['nameWithOwner'], (string) $node['number']),
            title: StringUtils::stripControlBytes($node['title']),
            ageInDays: daysSince($node['updatedAt']),
            repository: $node['repository']['nameWithOwner'],
            url: $node['url'],
            hint: "Review demandée par @{$node['author']['login']}.",
        );
    }

    /**
     * @param array<string, mixed> $node
     */
    public static function fromAssignedIssue(array $node): self
    {
        $author = self::authorLogin($node);

        return self::fromIssue($node, Section::AssignedIssues, "@{$author}", Icon::AssignedIssue, "Issue ouverte par @{$author}.");
    }

    /**
     * Like my PRs: it needs me once someone answered, otherwise it waits for them.
     *
     * @param array<string, mixed> $node
     */
    public static function fromCreatedIssue(array $node, string $viewerLogin): self
    {
        $lastWord = self::lastWord($node);
        $lastAuthor = self::authorLogin($lastWord);

        if (self::isAwaitingMe($lastWord, $viewerLogin)) {
            return self::fromIssue($node, Section::AwaitedReplies, "réponse de @{$lastAuthor}", Icon::AwaitedReply, "@{$lastAuthor} a répondu.");
        }

        return self::fromIssue($node, Section::CreatedIssues, $viewerLogin === $lastAuthor ? 'en attente' : "réponse de @{$lastAuthor}", Icon::CreatedIssue, 'Issue ouverte par toi.');
    }

    /**
     * GitHub finds every issue that ever mentioned me: only a last word that
     * names me still asks me something.
     *
     * @param array<string, mixed> $node
     */
    public static function fromMentioningIssue(array $node, string $viewerLogin): ?self
    {
        $lastWord = self::lastWord($node);
        if (!self::isAwaitingMe($lastWord, $viewerLogin) || 1 !== preg_match("{(?<![\\w/@-])@{$viewerLogin}(?![\\w-])}i", $lastWord['bodyText'])) {
            return null;
        }

        $lastAuthor = self::authorLogin($lastWord);

        return self::fromIssue($node, Section::AwaitedReplies, "mention de @{$lastAuthor}", Icon::AwaitedReply, "@{$lastAuthor} te mentionne.");
    }

    public static function forgottenMergedBranch(LocalBranch $branch, MergedBranch $merged): self
    {
        return self::forgottenBranch($branch, "{$branch->name} : PR mergée", $merged->url);
    }

    public static function forgottenGoneBranch(LocalBranch $branch): self
    {
        return self::forgottenBranch($branch, "{$branch->name} : supprimée sur GitHub");
    }

    public static function forgottenUnpushedBranch(LocalBranch $branch): self
    {
        return new self(
            section: Section::Forgotten,
            status: 'non poussée',
            icon: Icon::Forgotten,
            reference: $branch->repository,
            agentName: self::agentName($branch->repository, $branch->name),
            title: $branch->name,
            ageInDays: $branch->ageInDays,
            directory: $branch->directory(),
            inspection: new Inspection($branch->repository, $branch->checkout, 'git log --oneline -10 ' . escapeshellarg($branch->name)),
        );
    }

    public static function forgottenStash(string $directory, string $name, int $count, int $ageInDays): self
    {
        return new self(
            section: Section::Forgotten,
            status: 'stash',
            icon: Icon::Forgotten,
            reference: $name,
            agentName: self::agentName($name, 'stash'),
            title: 1 === $count ? '1 stash' : "{$count} stashes",
            ageInDays: $ageInDays,
            directory: $directory,
            inspection: new Inspection($name, $directory, 'git stash list'),
        );
    }

    public static function runningStack(string $name, ?string $directory, int $containers, int $ageInDays): self
    {
        return new self(
            section: Section::Forgotten,
            status: 'docker',
            icon: Icon::DockerStack,
            reference: $name,
            agentName: self::agentName($name, 'docker'),
            title: 1 === $containers ? '1 conteneur démarré' : "{$containers} conteneurs démarrés",
            ageInDays: $ageInDays,
            directory: $directory,
            hint: "Pour arrêter : docker compose -p {$name} stop",
            inspection: new Inspection($name, $directory ?? home(), 'docker compose -p ' . escapeshellarg($name) . ' ps'),
        );
    }

    /**
     * A repository has several forgotten branches: its name is not enough.
     */
    public function id(): string
    {
        return "{$this->reference} {$this->title}";
    }

    /**
     * @param array<string, mixed> $node
     */
    private static function fromIssue(array $node, Section $section, string $status, Icon $icon, string $hint): self
    {
        return new self(
            section: $section,
            status: $status,
            icon: $icon,
            reference: "{$node['repository']['nameWithOwner']}#{$node['number']}",
            agentName: self::agentName($node['repository']['nameWithOwner'], (string) $node['number']),
            title: StringUtils::stripControlBytes($node['title']),
            ageInDays: daysSince($node['updatedAt']),
            repository: $node['repository']['nameWithOwner'],
            url: $node['url'],
            hint: $hint,
        );
    }

    /**
     * The last comment, or else the issue itself: both have an author and a date.
     *
     * @param array<string, mixed> $node
     *
     * @return array<string, mixed>
     */
    private static function lastWord(array $node): array
    {
        return $node['comments']['nodes'][0] ?? $node;
    }

    /**
     * @param array<string, mixed> $lastWord
     */
    private static function isAwaitingMe(array $lastWord, string $viewerLogin): bool
    {
        return $viewerLogin !== self::authorLogin($lastWord) && daysSince($lastWord['createdAt']) <= self::AWAITED_REPLY_MAX_AGE_IN_DAYS;
    }

    /**
     * @param array<string, mixed> $node An issue or a comment
     */
    private static function authorLogin(array $node): string
    {
        // GitHub answers null for the author of a deleted account
        return $node['author']['login'] ?? 'ghost';
    }

    private static function forgottenBranch(LocalBranch $branch, string $title, ?string $url = null): self
    {
        return new self(
            section: Section::Forgotten,
            status: null === $branch->worktree ? 'branche' : 'worktree',
            icon: Icon::Forgotten,
            reference: $branch->repository,
            agentName: self::agentName($branch->repository, $branch->name),
            title: $title,
            ageInDays: $branch->ageInDays,
            url: $url,
            directory: $branch->directory(),
            hint: 'd pour supprimer',
            inspection: null === $branch->worktree
                ? new Inspection($branch->repository, $branch->checkout, 'git log --oneline -10 ' . escapeshellarg($branch->name))
                : new Inspection($branch->repository, $branch->worktree, 'git status && git log --oneline -10'),
            localBranch: $branch,
        );
    }

    /**
     * Herdr wants [a-z][a-z0-9_-]{0,31}: the suffix must survive a long name.
     */
    private static function agentName(string $repository, string $suffix): string
    {
        $slug = static fn (string $text) => (string) preg_replace('{[^a-z0-9_-]+}', '-', strtolower($text));
        $name = ltrim($slug(basename($repository)), '0123456789_-');
        $suffix = substr($slug($suffix), 0, 16);

        return substr('' === $name ? 'repository' : $name, 0, 31 - \strlen($suffix)) . "-{$suffix}";
    }

    /**
     * @param array<string, mixed> $node
     */
    private static function waitingStatus(array $node, string $ci): string
    {
        return implode(', ', array_filter([
            $node['isDraft'] ? 'draft' : null,
            ['EXPECTED' => 'CI en cours', 'NONE' => 'pas de CI', 'PENDING' => 'CI en cours', 'SUCCESS' => 'CI verte'][$ci] ?? null,
            'UNKNOWN' === $node['mergeable'] ? 'conflit ?' : null,
        ]));
    }

    /**
     * @param array<string, mixed> $node
     */
    private static function waitingIcon(array $node, string $ci): Icon
    {
        return match (true) {
            $node['isDraft'], 'NONE' === $ci => Icon::Idle,
            'SUCCESS' === $ci => Icon::CiPassed,
            default => Icon::CiRunning,
        };
    }

    /**
     * @param array{state: string, author: array{login: string}|null} $review
     */
    private static function renderReview(array $review): string
    {
        $icon = ['APPROVED' => '✔', 'CHANGES_REQUESTED' => '✎'][$review['state']] ?? '·';

        return "{$icon} @" . ($review['author']['login'] ?? 'ghost');
    }
}

final readonly class FailedCheck
{
    private const array FAILED_CONCLUSIONS = ['ACTION_REQUIRED', 'FAILURE', 'STARTUP_FAILURE', 'TIMED_OUT'];
    private const array FAILED_STATES = ['ERROR', 'FAILURE'];

    private function __construct(
        public string $name,
        public ?string $runId,
    ) {
    }

    /**
     * @param array<string, mixed>|null $rollup
     *
     * @return list<self>
     */
    public static function fromRollup(?array $rollup): array
    {
        $failedChecks = [];
        foreach ($rollup['contexts']['nodes'] ?? [] as $check) {
            if ('CheckRun' === $check['__typename'] && \in_array($check['conclusion'], self::FAILED_CONCLUSIONS, true)) {
                preg_match('{/actions/runs/(\d+)}', (string) $check['detailsUrl'], $matches);
                $failedChecks[] = new self(StringUtils::stripControlBytes($check['name']), $matches[1] ?? null);
            }

            if ('StatusContext' === $check['__typename'] && \in_array($check['state'], self::FAILED_STATES, true)) {
                $failedChecks[] = new self(StringUtils::stripControlBytes($check['context']), null);
            }
        }

        return $failedChecks;
    }
}

/**
 * Where to look at something I left behind, and the command that shows it.
 */
final readonly class Inspection
{
    /**
     * @param string $command Safe for a shell: what comes from a name is quoted
     */
    public function __construct(
        private string $title,
        private string $directory,
        private string $command,
    ) {
    }

    public function display(): string
    {
        return 'cd ' . str_replace(home(), '~', $this->directory) . " && {$this->command}";
    }

    /**
     * Runs the command, then leaves my shell open there until exit.
     */
    public function openShell(): void
    {
        $script = <<<'SHELL'
            printf '\033[H\033[2J\033[1;35mgh work\033[0m  %s  \033[2m(exit pour revenir)\033[0m\n\n$ %s\n' "$1" "$2"
            eval "$2"
            echo
            exec "${SHELL:-bash}"
            SHELL;

        // The title and the command go as arguments, never in the script itself
        new Process(['bash', '-c', $script, 'gh-work', $this->title, $this->command], $this->directory, timeout: null)
            ->setTty(true)
            ->run();
    }
}

