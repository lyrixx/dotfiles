final readonly class GitHub
{
    private const string CACHE_FILE = '/.cache/gh-work/snapshot.json';
    private const int MERGEABLE_ATTEMPTS = 3;
    private const float MERGEABLE_RETRY_DELAY_IN_SECONDS = 2;
    private const int QUERY_ATTEMPTS = 3;
    private const float QUERY_RETRY_DELAY_IN_SECONDS = 2;
    // It answers in 3 s: past that, the connection is hanging
    private const float QUERY_TIMEOUT_IN_SECONDS = 20;

    private const string QUERY = <<<'GRAPHQL'
        query {
          mine: search(query: "is:pr is:open author:@me archived:false", type: ISSUE, first: 100) {
            nodes {
              ... on PullRequest {
                number title url isDraft mergeable updatedAt headRefName additions deletions changedFiles
                repository { nameWithOwner }
                latestOpinionatedReviews(first: 20) { nodes { state author { login } } }
                reviewThreads(first: 50) { nodes { isResolved } }
                commits(last: 1) {
                  nodes {
                    commit {
                      statusCheckRollup {
                        state
                        contexts(first: 50) {
                          nodes {
                            __typename
                            ... on CheckRun { name conclusion detailsUrl }
                            ... on StatusContext { context state }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          requested: search(query: "is:pr is:open review-requested:@me archived:false", type: ISSUE, first: 50) {
            nodes {
              ... on PullRequest {
                number title url updatedAt
                author { login }
                repository { nameWithOwner }
              }
            }
          }
          merged: search(query: "is:pr is:merged author:@me sort:updated-desc", type: ISSUE, first: 100) {
            nodes {
              ... on PullRequest {
                number url updatedAt headRefName
                repository { nameWithOwner }
              }
            }
          }
        }
        GRAPHQL;

    public function fetch(): Snapshot
    {
        $data = $this->queryWithRetries();

        // GitHub computes mergeable on demand: the first read of a PR may say UNKNOWN
        for ($attempt = 1; $attempt < self::MERGEABLE_ATTEMPTS && self::hasUnknownMergeable($data); ++$attempt) {
            pause(self::MERGEABLE_RETRY_DELAY_IN_SECONDS);

            try {
                $data = $this->query();
            } catch (ProcessFailedException|ProcessTimedOutException) {
                // What we have is worth more than a failure: a few PRs say "conflit ?"
                break;
            }
        }

        $this->saveToCache($data);

        return Snapshot::fromGitHub($data, time());
    }

    /**
     * The last known state, for an unreliable connection.
     */
    public function cached(): ?Snapshot
    {
        $file = home() . self::CACHE_FILE;
        if (!is_file($file)) {
            return null;
        }

        try {
            $data = json_decode((string) file_get_contents($file), true, flags: \JSON_THROW_ON_ERROR);
        } catch (\JsonException) {
            return null;
        }

        return Snapshot::fromGitHub($data, (int) filemtime($file));
    }

    /**
     * @return list<string>
     */
    public function failedLogs(string $repository, string $runId, int $lineCount): array
    {
        $lines = explode("\n", trim(output(['gh', 'run', 'view', $runId, '--repo', $repository, '--log-failed'])));

        // The end of a log is the cleanup of the job: the cause is above the first error
        $firstError = array_find_key($lines, static fn (string $line) => str_contains($line, '##[error]'));
        $lastLine = $firstError ?? \count($lines) - 1;
        $relevantLines = \array_slice($lines, max(0, $lastLine - $lineCount + 1), min($lineCount, $lastLine + 1));

        return array_map(
            // The columns are the job, the step, then a timestamp and the line
            static fn (string $line) => StringUtils::stripControlBytes(AnsiUtils::stripAnsiCodes(preg_replace('{^[^\t]*\t[^\t]*\t\S+\s?}', '', $line) ?? $line)),
            $relevantLines,
        );
    }

    /**
     * @return array<string, mixed>
     */
    private function queryWithRetries(): array
    {
        for ($attempt = 1; ; ++$attempt) {
            try {
                return $this->query();
            } catch (ProcessFailedException|ProcessTimedOutException $exception) {
                if (self::QUERY_ATTEMPTS === $attempt) {
                    throw $exception;
                }
            }

            pause(self::QUERY_RETRY_DELAY_IN_SECONDS);
        }
    }

    /**
     * @return array<string, mixed>
     */
    private function query(): array
    {
        $response = output(['gh', 'api', 'graphql', '-f', 'query=' . self::QUERY], self::QUERY_TIMEOUT_IN_SECONDS);

        return json_decode($response, true, flags: \JSON_THROW_ON_ERROR)['data'];
    }

    /**
     * @param array<string, mixed> $data
     */
    private static function hasUnknownMergeable(array $data): bool
    {
        return \in_array('UNKNOWN', array_column($data['mine']['nodes'], 'mergeable'), true);
    }

    /**
     * @param array<string, mixed> $data
     */
    private function saveToCache(array $data): void
    {
        $file = home() . self::CACHE_FILE;
        if (!is_dir(\dirname($file)) && !mkdir(\dirname($file), recursive: true) && !is_dir(\dirname($file))) {
            throw new \RuntimeException(\sprintf('Could not create the directory of "%s".', $file));
        }

        // Atomic: a reader never sees a half-written file
        file_put_contents("{$file}.tmp", json_encode($data, \JSON_THROW_ON_ERROR));
        rename("{$file}.tmp", $file);
    }
}

/**
 * What lives on this machine: the checkouts, their worktrees and stashes, and
 * the transcripts of Claude.
 */
final readonly class Workspace
{
    // I work on Symfony from my fork: the clone of the main repository only follows it
    private const array CHECKOUT_OVERRIDES = ['symfony/symfony' => 'lyrixx/symfony'];
    private const string CHECKOUTS_DIRECTORY = '/dev/github.com';
    private const string CLAUDE_PROJECTS_DIRECTORY = '/.claude/projects';
    // Keep in sync with the branches brc, brcc, wtc and wtcc spare, in .gitconfig
    private const string DEFAULT_BRANCHES = '{^(master|main|develop)$}';
    private const string DEVELOPMENT_DIRECTORY = '/dev';
    // An older stash is an archive, not work I forgot
    private const int STASH_MAX_AGE_IN_DAYS = 60;

    public function pullRequestLinks(): PullRequestLinks
    {
        $matches = finishedProcess([
            'rg', '--no-config', '--no-ignore', '--with-filename', '--null', '--only-matching',
            '--max-depth', '2', '--glob', '*.jsonl', '--replace', '$1',
            '"type":"pr-link"[^\n]*?"prUrl":"([^"]+)"', home() . self::CLAUDE_PROJECTS_DIRECTORY,
        ])->getOutput();

        $transcriptsByUrl = [];
        foreach (array_filter(explode("\n", $matches)) as $match) {
            [$transcript, $url] = explode("\0", $match, 2);
            $transcriptsByUrl[$url][$transcript] = $transcript;
        }

        return new PullRequestLinks(array_map(array_values(...), $transcriptsByUrl));
    }

    public function locate(Entry $entry, PullRequestLinks $links): ?Location
    {
        if (null === $entry->repository) {
            return null === $entry->directory ? null : new Location($entry->directory);
        }

        $checkout = self::checkout($entry->repository);
        $worktree = null === $entry->branch ? null : $this->findWorktree($checkout, $entry->branch);

        $transcript = $links->latestTranscript($entry->url, self::projectPrefix($checkout));
        if (null === $transcript && null !== $entry->branch) {
            $transcript = $this->findTranscript($checkout, $entry->branch);
        }

        if (null !== $transcript) {
            $directory = $this->sessionDirectory($transcript);
            if (is_dir($directory)) {
                return new Location($directory, $worktree, basename($transcript, '.jsonl'));
            }
        }

        if (null !== $worktree) {
            return new Location($worktree, $worktree);
        }

        return is_dir($checkout) ? new Location($checkout) : null;
    }

    /**
     * @return list<Entry>
     */
    public function forgotten(Snapshot $snapshot): array
    {
        $entries = [];
        $seen = [];

        foreach ($snapshot->mergedBranches as $merged) {
            $key = "{$merged->repository}\t{$merged->branch}";
            if (isset($seen[$key]) || preg_match(self::DEFAULT_BRANCHES, $merged->branch) || $snapshot->hasOpenPullRequest($merged)) {
                continue;
            }
            $seen[$key] = true;

            $checkout = self::checkout($merged->repository);
            if (!is_dir($checkout)) {
                continue;
            }

            $worktree = $this->findWorktree($checkout, $merged->branch);
            if (null !== $worktree && $worktree !== $checkout) {
                $entries[] = Entry::forgottenWorktree($merged, $worktree);
            } elseif (finishedProcess(['git', '-C', $checkout, 'show-ref', '--verify', '--quiet', "refs/heads/{$merged->branch}"])->isSuccessful()) {
                $entries[] = Entry::forgottenLocalBranch($merged, $checkout);
            }
        }

        return [...$entries, ...$this->stashes()];
    }

    /**
     * @return list<Entry>
     */
    private function stashes(): array
    {
        $development = home() . self::DEVELOPMENT_DIRECTORY;
        // An unreadable directory makes find fail, with what it found so far
        $reflogs = finishedProcess(['find', $development, '-maxdepth', '7', '-path', '*/.git/logs/refs/stash', '-mtime', '-' . self::STASH_MAX_AGE_IN_DAYS])->getOutput();

        $entries = [];
        foreach (array_filter(explode("\n", $reflogs)) as $reflog) {
            $directory = substr($reflog, 0, -\strlen('/.git/logs/refs/stash'));
            $name = str_replace(["{$development}/github.com/", "{$development}/"], '', $directory);
            $entries[] = Entry::forgottenStash($directory, $name, \count(file($reflog) ?: []), intdiv(time() - (int) filemtime($reflog), 86400));
        }

        return $entries;
    }

    private function findWorktree(string $checkout, string $branch): ?string
    {
        if (!is_dir($checkout)) {
            return null;
        }

        $path = null;
        foreach (explode("\n", finishedProcess(['git', '-C', $checkout, 'worktree', 'list', '--porcelain'])->getOutput()) as $line) {
            if (str_starts_with($line, 'worktree ')) {
                $path = substr($line, \strlen('worktree '));
            }
            if ("branch refs/heads/{$branch}" === $line) {
                return $path;
            }
        }

        return null;
    }

    private function findTranscript(string $checkout, string $branch): ?string
    {
        $prefix = self::projectPrefix($checkout);
        $projects = glob(home() . self::CLAUDE_PROJECTS_DIRECTORY . "/{$prefix}*", \GLOB_ONLYDIR) ?: [];
        if ([] === $projects) {
            return null;
        }

        // --max-depth 1 leaves out the transcripts of subagents
        $matches = finishedProcess([
            'rg', '--no-config', '--no-ignore', '--files-with-matches', '--max-depth', '1', '--glob', '*.jsonl',
            '--fixed-strings', "\"gitBranch\":\"{$branch}\"", ...$projects,
        ])->getOutput();

        $transcripts = array_filter(explode("\n", $matches));
        usort($transcripts, static fn (string $a, string $b) => filemtime($b) <=> filemtime($a));

        return $transcripts[0] ?? null;
    }

    /**
     * A session resumes from the directory it started in, which is the first
     * cwd of its transcript, not the worktree it may have moved to.
     */
    private function sessionDirectory(string $transcript): string
    {
        $line = output(['rg', '--no-config', '--max-count', '1', '--fixed-strings', '"cwd":"', $transcript]);

        return json_decode($line, true, flags: \JSON_THROW_ON_ERROR)['cwd'];
    }

    private static function checkout(string $repository): string
    {
        return home() . self::CHECKOUTS_DIRECTORY . '/' . (self::CHECKOUT_OVERRIDES[$repository] ?? $repository);
    }

    /**
     * Claude names a project directory after its path, with / and . as dashes.
     * As a prefix, it also matches the worktrees of the project.
     */
    private static function projectPrefix(string $checkout): string
    {
        return str_replace(['/', '.'], '-', $checkout);
    }
}

/**
 * Herdr answers from any terminal, not only from one of its panes.
 */
final readonly class Herdr
{
    public function isRunning(): bool
    {
        return str_contains(finishedProcess(['herdr', 'status', 'server'])->getOutput(), 'status: running');
    }

    /**
     * @return list<Agent>
     */
    public function agents(): array
    {
        $agents = json_decode(output(['herdr', 'agent', 'list']), true, flags: \JSON_THROW_ON_ERROR)['result']['agents'];

        return array_values(array_map(
            // Only an agent started through Herdr has a name, not a claude typed by hand
            static fn (array $agent) => new Agent($agent['name'] ?? null, $agent['cwd'], $agent['agent_status'], $agent['tab_id']),
            array_filter($agents, static fn (array $agent) => 'claude' === $agent['agent']),
        ));
    }

    public function focus(Agent $agent): void
    {
        output(['herdr', 'tab', 'focus', $agent->tabId]);
    }

    public function startClaude(string $agentName, Location $location): void
    {
        $arguments = null === $location->sessionId ? [] : ['--', '--resume', $location->sessionId];

        output(['herdr-claude', $agentName, $location->directory, ...$arguments]);
    }
}

/**
 * @param list<string> $command
 */
function output(array $command, float $timeoutInSeconds = 60): string
{
    $process = finishedProcess($command, $timeoutInSeconds);
    if (!$process->isSuccessful()) {
        throw new ProcessFailedException($process);
    }

    return $process->getOutput();
}

/**
 * Waits without blocking the event loop: the dashboard keeps on drawing and
 * reading the keyboard in the meantime.
 *
 * @param list<string> $command
 */
function finishedProcess(array $command, float $timeoutInSeconds = 60): Process
{
    $process = new Process($command, timeout: $timeoutInSeconds);
    $process->start();

    while ($process->isRunning()) {
        $process->checkTimeout();
        pause(0.005);
    }

    return $process;
}

function pause(float $seconds): void
{
    $suspension = EventLoop::getSuspension();
    EventLoop::delay($seconds, static fn () => $suspension->resume());
    $suspension->suspend();
}

function daysSince(string $date): int
{
    return new \DateTimeImmutable($date)->diff(new \DateTimeImmutable())->days ?: 0;
}

function formatAge(int $timestamp): string
{
    $minutes = intdiv(time() - $timestamp, 60);

    return match (true) {
        $minutes < 1 => 'à l\'instant',
        $minutes < 60 => "il y a {$minutes} min",
        $minutes < 1440 => 'il y a ' . intdiv($minutes, 60) . ' h',
        default => 'il y a ' . intdiv($minutes, 1440) . ' j',
    };
}

function home(): string
{
    return (string) getenv('HOME');
}
