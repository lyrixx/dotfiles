#!/usr/bin/env -S castor --castor-file
<?php

// What needs me now, across all my repositories: my open PRs, the reviews asked
// of me, my issues and the replies expected from me, and what I left behind. It
// never changes anything on GitHub, and locally only the d key does, once
// confirmed: it deletes a branch and its worktree.

\defined('CASTOR_USE_CHDIR') || \define('CASTOR_USE_CHDIR', true);

use Castor\Attribute\AsOption;
use Castor\Attribute\AsTask;
use Revolt\EventLoop;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Process\Exception\ProcessFailedException;
use Symfony\Component\Process\Exception\ProcessTimedOutException;
use Symfony\Component\Process\Process;
use Symfony\Component\Tui\Ansi\AnsiUtils;
use Symfony\Component\Tui\Event\InputEvent;
use Symfony\Component\Tui\Input\Key;
use Symfony\Component\Tui\Input\Keybindings;
use Symfony\Component\Tui\Render\Compositor;
use Symfony\Component\Tui\Render\Layer;
use Symfony\Component\Tui\Render\RenderContext;
use Symfony\Component\Tui\Style\Border;
use Symfony\Component\Tui\Style\Padding;
use Symfony\Component\Tui\Style\Style;
use Symfony\Component\Tui\Style\StyleSheet;
use Symfony\Component\Tui\Style\TextAlign;
use Symfony\Component\Tui\Style\VerticalAlign;
use Symfony\Component\Tui\Tui;
use Symfony\Component\Tui\Widget\AbstractWidget;
use Symfony\Component\Tui\Widget\ContainerWidget;
use Symfony\Component\Tui\Widget\TextWidget;
use Symfony\Component\Tui\Widget\Util\StringUtils;
use Symfony\Component\Tui\Widget\VerticallyExpandableInterface;

use function Castor\context;
use function Castor\io;
use function Castor\run;

#[AsTask(default: true, description: 'What needs me now, across all my repositories')]
function work(
    #[AsOption(description: 'Leave once an agent is shown, for a Herdr popup')]
    bool $popup = false,
): void {
    $gitHub = new GitHub();
    $workspace = new Workspace();

    if (stream_isatty(\STDOUT) && stream_isatty(\STDIN)) {
        $dashboard = new Dashboard($gitHub, $workspace, new Herdr());
        $popup ? $dashboard->runInPopup() : $dashboard->run();

        return;
    }

    printBoard($gitHub, $workspace);
}

/**
 * For a pipe, or for an agent reading the output.
 */
function printBoard(GitHub $gitHub, Workspace $workspace): void
{
    try {
        $snapshot = $gitHub->fetch();
    } catch (ProcessFailedException|ProcessTimedOutException $exception) {
        $snapshot = $gitHub->cached() ?? throw $exception;
        io()->getErrorStyle()->warning('GitHub ne répond pas : données ' . formatAge($snapshot->fetchedAt) . '.');
    }

    $entries = [...$snapshot->entries, ...$workspace->forgotten($snapshot)];
    $links = $workspace->pullRequestLinks();

    foreach (Section::cases() as $section) {
        $sectionEntries = array_filter($entries, static fn (Entry $entry) => $entry->section === $section);
        io()->writeln(\sprintf("\n%s (%d)", $section->value, \count($sectionEntries)), OutputInterface::OUTPUT_RAW);

        foreach ($sectionEntries as $entry) {
            io()->writeln(\sprintf(
                '  %s%s%s  %s',
                mb_str_pad($entry->status, 24),
                mb_str_pad($entry->reference, 44),
                mb_str_pad("{$entry->ageInDays} j", 6),
                $entry->title,
            ), OutputInterface::OUTPUT_RAW);

            if (Section::ToDo === $section && null !== $location = $workspace->locate($entry, $links)) {
                io()->writeln('    ' . $location->command(), OutputInterface::OUTPUT_RAW);
            }
        }
    }
}

final class Dashboard
{
    private const float AGENTS_REFRESH_INTERVAL_IN_SECONDS = 5;
    private const float BOARD_REFRESH_INTERVAL_IN_SECONDS = 300;
    private const float CLOCK_REFRESH_INTERVAL_IN_SECONDS = 30;
    private const float FAILED_LOAD_RETRY_INTERVAL_IN_SECONDS = 30;
    // Held down, any other key would act once per repeat: o would open a tab each time
    private const array KEY_REPEAT_ACTIONS = ['down', 'next_section', 'page_down', 'page_up', 'previous_section', 'up'];
    private const array SPINNER_FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
    private const float SPINNER_INTERVAL_IN_SECONDS = 0.08;

    private readonly BoardWidget $board;
    private readonly TextWidget $detail;
    private readonly ContainerWidget $detailBox;
    private readonly LineWidget $footer;
    private readonly LineWidget $header;
    private readonly Keybindings $keys;
    private readonly ContainerWidget $splash;
    private readonly LineWidget $splashLoader;
    private readonly Tui $tui;

    /** @var list<Agent> */
    private array $agents = [];
    private bool $agentsLoading = false;
    /** @var list<Entry> Kept during a refresh: they take longer to find than the PRs */
    private array $forgotten = [];
    private bool $hasFreshData = false;
    private bool $helpVisible = false;
    private bool $herdrRunning = false;
    private bool $inPopup = false;
    private bool $lastLoadFailed = false;
    private bool $loading = false;
    private ?LogViewer $logViewer = null;
    private int $localSearch = 0;
    /** @var array<string, Location> By id */
    private array $locations = [];
    /** @var array<string, list<string>> The failed CI logs, by id */
    private array $logs = [];
    /** @var array<string, string> Why an action failed on a line, by id */
    private array $failures = [];
    private ?string $notice = null;
    private ?Entry $pendingDeletion = null;
    private ?Location $resumeAfterExit = null;
    private ?Inspection $shellRequest = null;
    private bool $showingBoard = false;
    private ?int $snapshotFetchedAt = null;
    private int $spinnerFrame = 0;
    /** @var array<string, true> What is running, by label */
    private array $tasks = [];

    public function __construct(
        private readonly GitHub $gitHub,
        private readonly Workspace $workspace,
        private readonly Herdr $herdr,
    ) {
        $this->keys = new Keybindings([
            'bottom' => [Key::END],
            'delete' => ['d'],
            'down' => [Key::DOWN, 'j'],
            'interrupt' => ['ctrl+c'],
            'logs' => ['l'],
            'next_section' => [Key::TAB],
            'open' => ['o'],
            'page_down' => [Key::PAGE_DOWN, Key::SPACE],
            'page_up' => [Key::PAGE_UP],
            'previous_section' => ['shift+tab'],
            'quit' => ['q', Key::ESCAPE],
            'refresh' => ['r'],
            'resume' => [Key::ENTER],
            'top' => [Key::HOME, 'g'],
            'up' => [Key::UP, 'k'],
        ]);

        $this->tui = new Tui(new StyleSheet([
            '.logo' => new Style(color: Tone::Accent->value, font: 'slant', textAlign: TextAlign::Center),
            '.splash' => new Style(gap: 1, verticalAlign: VerticalAlign::Center),
        ]));

        $this->board = new BoardWidget();
        $this->detail = new TextWidget(truncate: true);
        $this->detailBox = new ContainerWidget();
        $this->detailBox->add($this->detail);
        $this->footer = new LineWidget($this->renderFooter(...));
        $this->header = new LineWidget($this->renderHeader(...));

        $logo = new TextWidget('gh work');
        $logo->addStyleClass('logo');
        $this->splashLoader = new LineWidget($this->renderSplashLoader(...));
        $this->splash = new ContainerWidget();
        $this->splash->addStyleClass('splash');
        $this->splash->expandVertically(true);
        $this->splash->add($logo);
        $this->splash->add($this->splashLoader);
    }

    public function run(): void
    {
        $cached = $this->gitHub->cached();
        if (null === $cached) {
            $this->tui->add($this->splash);
        } else {
            $this->showSnapshot($cached);
            // It only needs the disk: no reason to wait for the network
            EventLoop::queue(fn () => $this->findLocalState($cached));
        }

        $this->tui->addListener($this->handleKey(...));
        $this->tui->scheduleInterval($this->tickSpinner(...), self::SPINNER_INTERVAL_IN_SECONDS);
        $this->tui->scheduleInterval($this->redraw(...), self::CLOCK_REFRESH_INTERVAL_IN_SECONDS);
        $this->tui->scheduleInterval($this->load(...), self::BOARD_REFRESH_INTERVAL_IN_SECONDS);
        $this->tui->scheduleInterval($this->retryFailedLoad(...), self::FAILED_LOAD_RETRY_INTERVAL_IN_SECONDS);
        $this->tui->scheduleInterval($this->loadAgents(...), self::AGENTS_REFRESH_INTERVAL_IN_SECONDS);

        $this->load();
        $this->loadAgents();

        // The alternate screen gives the terminal back as it was
        fwrite(\STDOUT, "\e[?1049h\e[H");
        try {
            $this->tui->run();
            while (null !== $this->shellRequest) {
                $inspection = $this->shellRequest;
                $this->shellRequest = null;
                fwrite(\STDOUT, "\e[?1049l");
                $inspection->openShell();
                fwrite(\STDOUT, "\e[?1049h\e[H\e[2J");
                // The screen was cleared behind its back: everything is drawn again
                $this->tui->requestRender(true);
                $this->tui->run();
            }
        } finally {
            fwrite(\STDOUT, "\e[?1049l");
        }

        if (null !== $this->resumeAfterExit) {
            $this->resumeInThisTerminal($this->resumeAfterExit);
        }
    }

    public function runInPopup(): void
    {
        $this->inPopup = true;
        $this->run();
    }

    private function load(): void
    {
        if ($this->loading) {
            return;
        }

        $this->loading = true;
        $this->notice = null;
        $this->tasks['GitHub'] = true;
        $this->redraw();

        EventLoop::queue(function (): void {
            try {
                $snapshot = $this->gitHub->fetch();
                $this->lastLoadFailed = false;
                unset($this->tasks['GitHub']);
                $this->showFreshSnapshot($snapshot);
            } catch (ProcessFailedException|ProcessTimedOutException) {
                $this->lastLoadFailed = true;
                $this->showBoard();
                $this->notice = 'GitHub injoignable, nouvel essai dans 30 s';
            } finally {
                $this->loading = false;
                unset($this->tasks['GitHub']);
                $this->redraw();
            }
        });
    }

    private function retryFailedLoad(): void
    {
        if ($this->lastLoadFailed) {
            $this->load();
        }
    }

    private function showFreshSnapshot(Snapshot $snapshot): void
    {
        if ($this->hasFreshData) {
            $this->notifyChanges($snapshot->entries);
        }

        $this->hasFreshData = true;
        $this->logs = [];
        $this->showSnapshot($snapshot);
        $this->findLocalState($snapshot);
    }

    private function showSnapshot(Snapshot $snapshot): void
    {
        $this->showBoard();
        $this->snapshotFetchedAt = $snapshot->fetchedAt;
        $this->board->setEntries([...$snapshot->entries, ...$this->forgotten]);
    }

    private function showBoard(): void
    {
        if ($this->showingBoard) {
            return;
        }

        $this->showingBoard = true;
        $this->tui->clear();
        $this->tui->add($this->header);
        $this->tui->add($this->board);
        $this->tui->add($this->detailBox);
        $this->tui->add($this->footer);
    }

    private function findLocalState(Snapshot $snapshot): void
    {
        // A newer snapshot takes over: this search would only overwrite it
        $search = ++$this->localSearch;
        $isStale = fn () => $search !== $this->localSearch;

        $this->tasks['sessions Claude'] = true;
        $this->redraw();
        $links = $this->workspace->pullRequestLinks();
        foreach ($snapshot->entries as $entry) {
            $this->locate($entry, $links);
            if ($isStale()) {
                return;
            }
        }
        unset($this->tasks['sessions Claude']);

        $this->tasks['worktrees et stashes'] = true;
        $this->redraw();
        $this->forgotten = $this->workspace->forgotten($snapshot);
        if ($isStale()) {
            return;
        }

        $this->board->setEntries([...$snapshot->entries, ...$this->forgotten]);
        foreach ($this->forgotten as $entry) {
            $this->locate($entry, $links);
        }
        unset($this->tasks['worktrees et stashes']);
        $this->redraw();
    }

    private function locate(Entry $entry, PullRequestLinks $links): void
    {
        $location = $this->workspace->locate($entry, $links);
        if (null !== $location) {
            $this->locations[$entry->id()] = $location;
        }
        $this->redraw();
    }

    /**
     * @param list<Entry> $entries
     */
    private function notifyChanges(array $entries): void
    {
        $previousStatuses = [];
        foreach ($this->board->entries() as $entry) {
            $previousStatuses[$entry->id()] = $entry->status;
        }

        foreach ($entries as $entry) {
            $previousStatus = $previousStatuses[$entry->id()] ?? $entry->status;
            if (Section::ToDo === $entry->section && $previousStatus !== $entry->status) {
                $this->runInBackground(['notify-send', '--app-name=gh work', $entry->reference, "{$entry->status} : {$entry->title}"]);
            }
        }
    }

    private function loadAgents(): void
    {
        if ($this->agentsLoading) {
            return;
        }

        $this->agentsLoading = true;
        EventLoop::queue(function (): void {
            try {
                $this->herdrRunning = $this->herdr->isRunning();
                $this->agents = $this->herdrRunning ? $this->herdr->agents() : [];
            } catch (ProcessFailedException|ProcessTimedOutException) {
                $this->agents = [];
                $this->notice = 'Herdr ne répond pas';
            } finally {
                $this->agentsLoading = false;
                $this->redraw();
            }
        });
    }

    private function handleKey(InputEvent $event): void
    {
        $data = $event->getData();

        // With the Kitty protocol, a key also reports its release, and its repeats
        // while held: to a modal, they would look like another key
        $parser = $this->keys->getParser();
        if ($parser->isKeyRelease($data)) {
            return;
        }
        $isRepeat = $parser->isKeyRepeat($data);

        if ($this->keys->matches($data, 'interrupt')) {
            $this->tui->stop();

            return;
        }

        if (null !== $this->pendingDeletion) {
            if (!$isRepeat) {
                $this->answerDeletion($this->pendingDeletion, $data);
            }

            return;
        }

        if (null !== $this->logViewer) {
            $this->scrollLogs($this->logViewer, $data);

            return;
        }

        if (!$isRepeat && ($this->isHelpKey($data) || ($this->helpVisible && $this->keys->matches($data, 'quit')))) {
            $this->toggleHelp();

            return;
        }

        if ($this->helpVisible) {
            return;
        }

        // G is Shift+g: matched on what it types
        $typed = $parser->decodePrintable($data) ?? $data;
        if ('G' === $typed) {
            $this->board->moveToLast();
            $this->redraw();

            return;
        }

        $actions = [
            'bottom' => $this->board->moveToLast(...),
            'delete' => $this->askDeletion(...),
            'down' => fn () => $this->board->moveBy(1),
            'logs' => $this->showLogs(...),
            'next_section' => fn () => $this->board->moveToSection(1),
            'open' => $this->openInBrowser(...),
            'page_down' => fn () => $this->board->moveByPage(1),
            'page_up' => fn () => $this->board->moveByPage(-1),
            'previous_section' => fn () => $this->board->moveToSection(-1),
            'quit' => $this->tui->stop(...),
            'refresh' => $this->load(...),
            'resume' => $this->resume(...),
            'top' => $this->board->moveToFirst(...),
            'up' => fn () => $this->board->moveBy(-1),
        ];

        foreach ($actions as $action => $callback) {
            if ($this->keys->matches($data, $action)) {
                if (!$isRepeat || \in_array($action, self::KEY_REPEAT_ACTIONS, true)) {
                    $callback();
                    $this->redraw();
                }

                return;
            }
        }
    }

    /**
     * ? needs Shift on most layouts, and a terminal speaking the Kitty protocol
     * may report that as an escape sequence, which no key identifier matches.
     */
    private function isHelpKey(string $data): bool
    {
        return '?' === ($this->keys->getParser()->decodePrintable($data) ?? $data);
    }

    private function toggleHelp(): void
    {
        if (!$this->showingBoard) {
            return;
        }

        $this->helpVisible = !$this->helpVisible;
        $this->board->setModal($this->helpVisible ? static fn () => Modal::help() : null);
        $this->redraw();
    }

    private function askDeletion(): void
    {
        $entry = $this->board->selected();
        if (null === $entry) {
            return;
        }

        $branch = $entry->localBranch;
        $reason = null === $branch ? 'd ne supprime que les branches et worktrees déjà partis de GitHub' : $this->deletionBlocker($branch);
        if (null !== $reason || null === $branch) {
            // Also in the detail, next to the line: the header is easy to miss, and cut
            $this->notice = 'Suppression impossible : le détail dit pourquoi';
            $this->failures[$entry->id()] = (string) $reason;

            return;
        }

        $this->notice = null;
        unset($this->failures[$entry->id()]);
        $this->pendingDeletion = $entry;
        $this->board->setModal(static fn () => Modal::deletion($branch));
    }

    private function deletionBlocker(LocalBranch $branch): ?string
    {
        if (null !== $branch->lock && !$branch->lock->isStale()) {
            return $branch->lock->isClaudeSession() ? 'Une session Claude utilise encore ce worktree' : "Worktree verrouillé : {$branch->lock->reason}";
        }

        if (null !== array_find($this->agents, static fn (Agent $agent) => $branch->worktreeContains($agent->directory))) {
            return 'Claude tourne dans ce worktree';
        }

        $stacks = array_filter($this->board->entries(), static fn (Entry $entry) => Icon::DockerStack === $entry->icon);
        if (null !== array_find($stacks, static fn (Entry $stack) => null !== $stack->directory && $branch->worktreeContains($stack->directory))) {
            return 'Une stack Docker tourne dans ce worktree';
        }

        return null;
    }

    private function answerDeletion(Entry $entry, string $data): void
    {
        $this->pendingDeletion = null;
        $this->board->setModal(null);

        // Whatever form the terminal reports it in: plain text or a Kitty sequence
        $typed = $this->keys->getParser()->decodePrintable($data) ?? $data;
        if (\in_array($typed, ['y', 'Y'], true) && null !== $entry->localBranch) {
            $this->deleteBranch($entry, $entry->localBranch);
        } else {
            $this->notice = 'Suppression annulée';
        }

        $this->redraw();
    }

    private function deleteBranch(Entry $entry, LocalBranch $branch): void
    {
        $this->tasks['suppression'] = true;
        EventLoop::queue(function () use ($branch, $entry): void {
            try {
                $commit = $this->workspace->deleteBranch($branch);
                $isOther = static fn (Entry $other) => $other->id() !== $entry->id();
                $this->forgotten = array_values(array_filter($this->forgotten, $isOther));
                $this->board->setEntries(array_values(array_filter($this->board->entries(), $isOther)));
                $this->notice = "Supprimée. Pour la récupérer : git branch {$branch->name} {$commit}";
            } catch (ProcessFailedException|ProcessTimedOutException $exception) {
                $this->notice = 'Suppression refusée : le détail dit pourquoi';
                $this->failures[$entry->id()] = 'Refusé : ' . str_replace(home(), '~', (string) strtok($exception->getProcess()->getErrorOutput(), "\n"));
            } finally {
                unset($this->tasks['suppression']);
                $this->redraw();
            }
        });
    }

    private function resume(): void
    {
        $entry = $this->board->selected();
        if (null === $entry) {
            return;
        }

        // What I left behind is looked at with git, not with Claude: a shell
        // there, back here with exit, like the scratch terminal of Herdr
        if (null !== $entry->inspection) {
            $this->shellRequest = $entry->inspection;
            $this->tui->stop();

            return;
        }

        $location = $this->locations[$entry->id()] ?? null;
        $agent = $this->agentOf($entry, $location);
        if (null !== $agent) {
            $this->notice = null;
            $this->focusAgent($agent);

            return;
        }

        if (null === $location) {
            $this->notice = 'Ce dépôt n\'est pas cloné sur cette machine';

            return;
        }

        if (!$this->herdrRunning) {
            $this->resumeAfterExit = $location;
            $this->tui->stop();

            return;
        }

        $this->notice = null;
        $this->startClaude($entry, $location);
    }

    private function focusAgent(Agent $agent): void
    {
        EventLoop::queue(function () use ($agent): void {
            try {
                $this->herdr->focus($agent);
                $this->leaveIfInPopup();
            } catch (ProcessFailedException|ProcessTimedOutException) {
                $this->notice = 'Herdr n\'a pas pu afficher l\'onglet';
                $this->redraw();
            }
        });
    }

    private function startClaude(Entry $entry, Location $location): void
    {
        // Claude takes seconds to start: a second Enter would start it twice
        if (isset($this->tasks['ouverture de Claude'])) {
            return;
        }

        $this->tasks['ouverture de Claude'] = true;
        EventLoop::queue(function () use ($entry, $location): void {
            try {
                if ($this->inPopup) {
                    // No waiting behind the popup: Claude may ask me to trust the directory
                    $this->herdr->startClaudeWithoutWaiting($entry->agentName, $location);
                    $this->tui->stop();

                    return;
                }

                $this->herdr->startClaude($entry->agentName, $location);
                $this->loadAgents();
            } catch (ProcessFailedException|ProcessTimedOutException) {
                $this->notice = 'Claude n\'a pas démarré : regarde son onglet dans Herdr';
            } finally {
                unset($this->tasks['ouverture de Claude']);
                $this->redraw();
            }
        });
    }

    /**
     * Herdr ties a popup to its tab: it would stay in front of an agent of that
     * tab, and come back with the tab otherwise. While hidden, it even blocks
     * its own shortcut.
     */
    private function leaveIfInPopup(): void
    {
        if ($this->inPopup) {
            $this->tui->stop();
        }
    }

    private function resumeInThisTerminal(Location $location): void
    {
        if (null === $location->sessionId) {
            io()->writeln($location->command(), OutputInterface::OUTPUT_RAW);

            return;
        }

        run(['claude', '--resume', $location->sessionId], context: context()->withWorkingDirectory($location->directory)->withTty());
    }

    private function openInBrowser(): void
    {
        $url = $this->board->selected()?->url;
        if (null === $url) {
            $this->notice = 'Pas de page GitHub pour cette ligne';

            return;
        }

        $this->runInBackground(['xdg-open', $url]);
    }

    private function showLogs(): void
    {
        $entry = $this->board->selected();
        $check = null === $entry ? null : array_find($entry->failedChecks, static fn (FailedCheck $check) => null !== $check->runId);
        if (null === $entry || null === $check) {
            $this->notice = 'Pas de log GitHub Actions pour cette ligne';

            return;
        }

        if (isset($this->logs[$entry->id()])) {
            $this->openLogs($entry, $this->logs[$entry->id()]);

            return;
        }

        if (isset($this->tasks['logs de la CI'])) {
            return;
        }

        $this->tasks['logs de la CI'] = true;
        EventLoop::queue(function () use ($check, $entry): void {
            try {
                $this->logs[$entry->id()] = $this->gitHub->failedLogs((string) $entry->repository, (string) $check->runId);
                unset($this->failures[$entry->id()]);
                // Another modal opened in the meantime: the log waits for the next l
                if (!$this->hasModal()) {
                    $this->openLogs($entry, $this->logs[$entry->id()]);
                }
            } catch (ProcessFailedException|ProcessTimedOutException) {
                $this->notice = 'Logs de la CI indisponibles : le détail dit pourquoi';
                $this->failures[$entry->id()] = 'Logs de la CI indisponibles : expirés, ou GitHub injoignable';
            } finally {
                unset($this->tasks['logs de la CI']);
                $this->redraw();
            }
        });
    }

    /**
     * @param list<string> $lines
     */
    private function openLogs(Entry $entry, array $lines): void
    {
        $this->logViewer = new LogViewer("Logs de {$entry->reference}", $lines);
        $this->board->setModal($this->logViewer->render(...));
        $this->redraw();
    }

    private function scrollLogs(LogViewer $viewer, string $data): void
    {
        $typed = $this->keys->getParser()->decodePrintable($data) ?? $data;

        match (true) {
            $this->keys->matches($data, 'quit') || $this->keys->matches($data, 'logs') => $this->closeLogs(),
            'G' === $typed || $this->keys->matches($data, 'bottom') => $viewer->scrollToBottom(),
            $this->keys->matches($data, 'top') => $viewer->scrollToTop(),
            $this->keys->matches($data, 'down') => $viewer->scroll(1),
            $this->keys->matches($data, 'up') => $viewer->scroll(-1),
            $this->keys->matches($data, 'page_down') => $viewer->scrollPage(1),
            $this->keys->matches($data, 'page_up') => $viewer->scrollPage(-1),
            default => null,
        };

        $this->board->invalidate();
        $this->tui->requestRender();
    }

    private function closeLogs(): void
    {
        $this->logViewer = null;
        $this->board->setModal(null);
        $this->redraw();
    }

    private function hasModal(): bool
    {
        return $this->helpVisible || null !== $this->pendingDeletion || null !== $this->logViewer;
    }

    /**
     * @param list<string> $command
     */
    private function runInBackground(array $command): void
    {
        EventLoop::queue(static fn () => finishedProcess($command));
    }

    private function tickSpinner(): void
    {
        if ([] === $this->tasks) {
            return;
        }

        $this->spinnerFrame = ($this->spinnerFrame + 1) % \count(self::SPINNER_FRAMES);
        $this->header->invalidate();
        $this->splashLoader->invalidate();
        $this->tui->requestRender();
    }

    private function redraw(): void
    {
        $entry = $this->board->selected();
        $this->detail->setText(null === $entry ? '' : $this->renderDetail($entry));
        $this->detailBox->setStyle(new Style(
            border: Border::all(1, 'rounded', ($entry?->icon->tone() ?? Tone::Muted)->value),
            hidden: $this->hasModal() ?: null,
            padding: Padding::xy(1, 0),
        ));
        $this->board->setActiveIds($this->activeIds());
        $this->header->invalidate();
        $this->footer->invalidate();
        $this->tui->requestRender();
    }

    private function renderSplashLoader(int $columns): string
    {
        $message = 'Je demande à GitHub ce qui t\'attend…';
        $indent = intdiv($columns - AnsiUtils::visibleWidth($message) - 2, 2);

        return str_repeat(' ', max(0, $indent)) . paint(self::SPINNER_FRAMES[$this->spinnerFrame], Tone::Accent) . ' ' . paint($message, Tone::Muted);
    }

    private function renderHeader(int $columns): string
    {
        $entries = $this->board->entries();
        $count = static fn (Section $section) => \count(array_filter($entries, static fn (Entry $entry) => $entry->section === $section));

        $left = new Style(background: Tone::Accent->value, color: '#000000', bold: true)->apply(' gh work ') . '  ';
        foreach ($entries as $entry) {
            if (\in_array($entry->section, [Section::Rest, Section::ToDo], true)) {
                $left .= paint('■', $entry->icon->tone());
            }
        }
        $left .= '  ' . implode('  ', [
            paint(\sprintf('%d à toi', $count(Section::ToDo)), Tone::Danger),
            paint(\sprintf('%d reviews', $count(Section::Reviews)), Tone::Info),
            paint(\sprintf('%d réponses', $count(Section::AwaitedReplies)), Tone::Info),
            paint(\sprintf('%d assignées', $count(Section::AssignedIssues)), Tone::Warning),
            paint(\sprintf('%d en attente', $count(Section::Rest)), Tone::Success),
            paint(\sprintf('%d oubliés', $count(Section::Forgotten)), Tone::Muted),
        ]);

        $age = null === $this->snapshotFetchedAt ? null : formatAge($this->snapshotFetchedAt);
        $right = implode(paint('  ·  ', Tone::Muted), array_filter([
            null === $this->notice ? null : paint($this->notice, Tone::Warning),
            [] === $this->tasks ? null : paint(self::SPINNER_FRAMES[$this->spinnerFrame] . ' ' . implode(', ', array_keys($this->tasks)) . '…', Tone::Accent),
            null === $age ? null : paint($age, $this->hasFreshData ? Tone::Muted : Tone::Warning),
        ]));

        $gap = $columns - AnsiUtils::visibleWidth($left) - AnsiUtils::visibleWidth($right) - 1;
        if ($gap < 1) {
            // What a notice says matters more than the counters
            return ' ' . $right;
        }

        return $left . str_repeat(' ', $gap) . $right;
    }

    private function renderFooter(int $columns): string
    {
        $parts = [];
        foreach (['Entrée' => 'ouvrir', '?' => 'aide', 'q' => 'quitter'] as $key => $label) {
            $parts[] = paint($key, Tone::Text, bold: true) . ' ' . paint($label, Tone::Muted);
        }

        return ' ' . implode('   ', $parts);
    }

    private function renderDetail(Entry $entry): string
    {
        $lines = [
            paint($entry->reference, Tone::Text, bold: true) . '  ' . paint($entry->status, $entry->icon->tone()),
            paint($entry->title, Tone::Text),
            $this->renderFacts($entry),
        ];

        if ([] !== $entry->failedChecks) {
            $names = array_map(static fn (FailedCheck $check) => $check->name, $entry->failedChecks);
            $lines[] = paint(\sprintf('✘ %d en échec : ', \count($names)), Tone::Danger, bold: true) . paint(implode(' · ', $names), Tone::Danger);
        }

        $lines[] = $this->renderLocation($entry);

        if (isset($this->failures[$entry->id()])) {
            $lines[] = paint('✘ ' . $this->failures[$entry->id()], Tone::Danger, bold: true);
        }

        return implode("\n", $lines);
    }

    private function renderFacts(Entry $entry): string
    {
        if (null !== $entry->hint) {
            return paint($entry->hint, Tone::Muted);
        }

        $facts = [paint("⎇ {$entry->branch}", Tone::Info)];
        if ($entry->changedFiles > 0) {
            $facts[] = paint("+{$entry->additions}", Tone::Success) . ' ' . paint("−{$entry->deletions}", Tone::Danger) . paint(" dans {$entry->changedFiles} fichiers", Tone::Muted);
        }
        foreach ($entry->reviews as $review) {
            $facts[] = paint($review, Tone::Text);
        }
        if ($entry->unresolvedThreads > 0) {
            $facts[] = paint("{$entry->unresolvedThreads} fils non résolus", Tone::Warning);
        }

        return implode(paint('  ·  ', Tone::Muted), $facts);
    }

    private function renderLocation(Entry $entry): string
    {
        if (null !== $entry->inspection) {
            return paint('▶ Entrée : un terminal, avec ' . $entry->inspection->display(), Tone::Accent);
        }

        $location = $this->locations[$entry->id()] ?? null;
        $agent = $this->agentOf($entry, $location);
        if (null !== $agent) {
            return paint(Icon::Agent->value . " Claude tourne ici ({$agent->status}) : Entrée pour y aller", Tone::Accent);
        }

        if (null === $location) {
            return paint([] === $this->tasks ? 'Ce dépôt n\'est pas cloné sur cette machine.' : 'Je cherche la session…', Tone::Muted);
        }

        return paint('▶ ' . $location->command(), Tone::Accent);
    }

    /**
     * By name when gh work started it, by directory when I started it myself.
     */
    private function agentOf(Entry $entry, ?Location $location): ?Agent
    {
        return array_find($this->agents, static fn (Agent $agent) => $agent->name === $entry->agentName || true === $location?->isIn($agent->directory));
    }

    /**
     * @return list<string>
     */
    private function activeIds(): array
    {
        $ids = [];
        foreach ($this->board->entries() as $entry) {
            if (null !== $this->agentOf($entry, $this->locations[$entry->id()] ?? null)) {
                $ids[] = $entry->id();
            }
        }

        return $ids;
    }
}

/**
 * The list of entries, grouped by section, with one highlighted line.
 */
final class BoardWidget extends AbstractWidget implements VerticallyExpandableInterface
{
    private const int AGE_WIDTH = 6;
    private const int MAX_REFERENCE_WIDTH = 44;
    private const int MAX_STATUS_WIDTH = 24;
    private const int MIN_TITLE_WIDTH = 16;

    /** @var list<string> */
    private array $activeIds = [];
    /** @var list<Entry> */
    private array $entries = [];
    /** @var (\Closure(int, int): list<string>)|null Its lines, for the columns and rows of the board */
    private ?\Closure $modal = null;
    private int $selectedIndex = 0;
    private int $visibleRows = 1;

    /**
     * @param list<Entry> $entries
     */
    public function setEntries(array $entries): void
    {
        $selectedId = $this->selected()?->id();
        usort($entries, static fn (Entry $a, Entry $b) => $a->section->position() <=> $b->section->position());
        $this->entries = $entries;

        $index = array_find_key($entries, static fn (Entry $entry) => $entry->id() === $selectedId);
        $this->selectedIndex = $index ?? max(0, min($this->selectedIndex, \count($entries) - 1));
        $this->invalidate();
    }

    /**
     * @return list<Entry>
     */
    public function entries(): array
    {
        return $this->entries;
    }

    public function selected(): ?Entry
    {
        return $this->entries[$this->selectedIndex] ?? null;
    }

    /**
     * @param list<string> $activeIds
     */
    public function setActiveIds(array $activeIds): void
    {
        if ($this->activeIds !== $activeIds) {
            $this->activeIds = $activeIds;
            $this->invalidate();
        }
    }

    /**
     * @param (\Closure(int, int): list<string>)|null $modal
     */
    public function setModal(?\Closure $modal): void
    {
        $this->modal = $modal;
        $this->invalidate();
    }

    public function moveBy(int $offset): void
    {
        if ([] === $this->entries) {
            return;
        }

        $this->selectedIndex = ($this->selectedIndex + $offset + \count($this->entries)) % \count($this->entries);
        $this->invalidate();
    }

    public function moveByPage(int $direction): void
    {
        if ([] === $this->entries) {
            return;
        }

        // A page of lines holds fewer entries: the titles of the sections take rows
        $this->selectedIndex = max(0, min($this->selectedIndex + $direction * max(1, $this->visibleRows - 4), \count($this->entries) - 1));
        $this->invalidate();
    }

    public function moveToFirst(): void
    {
        $this->selectedIndex = 0;
        $this->invalidate();
    }

    public function moveToLast(): void
    {
        $this->selectedIndex = max(0, \count($this->entries) - 1);
        $this->invalidate();
    }

    public function moveToSection(int $direction): void
    {
        $current = $this->selected()?->section;
        $count = \count($this->entries);

        for ($step = 1; $step < $count; ++$step) {
            $index = ($this->selectedIndex + $direction * $step + $count * $step) % $count;
            if ($this->entries[$index]->section !== $current) {
                $section = $this->entries[$index]->section;
                $this->selectedIndex = (int) array_find_key($this->entries, static fn (Entry $entry) => $entry->section === $section);
                $this->invalidate();

                return;
            }
        }
    }

    public function expandVertically(bool $expand): static
    {
        return $this;
    }

    public function isVerticallyExpanded(): bool
    {
        return true;
    }

    public function render(RenderContext $context): array
    {
        $columns = $context->getColumns();
        $rows = max(1, $context->getRows());
        $this->visibleRows = $rows;

        $lines = [''];
        $selectedLine = 0;
        $section = null;

        if ([] !== $this->entries && [] === array_filter($this->entries, static fn (Entry $entry) => Section::ToDo === $entry->section)) {
            $lines[] = $this->renderSection(Section::ToDo, 0, $columns);
            $lines[] = '   ' . paint(Icon::ReadyToMerge->value . ' Rien ne t\'attend.', Tone::Success);
            $lines[] = '';
        }

        [$statusWidth, $referenceWidth, $titleWidth] = $this->columnWidths($columns);

        foreach ($this->entries as $index => $entry) {
            if ($entry->section !== $section) {
                if (null !== $section) {
                    $lines[] = '';
                }
                $section = $entry->section;
                $sectionEntries = array_filter($this->entries, static fn (Entry $other) => $other->section === $entry->section);
                $lines[] = $this->renderSection($section, \count($sectionEntries), $columns);
            }

            if ($index === $this->selectedIndex) {
                $selectedLine = \count($lines);
            }
            $lines[] = $this->renderEntry($entry, $index === $this->selectedIndex, $columns, $statusWidth, $referenceWidth, $titleWidth);
        }

        $firstLine = max(0, min($selectedLine - intdiv($rows, 2), \count($lines) - $rows));

        $visibleLines = array_pad(\array_slice($lines, $firstLine, $rows), $rows, '');

        return null === $this->modal ? $visibleLines : $this->renderModal(($this->modal)($columns, $rows), $visibleLines, $columns, $rows);
    }

    /**
     * @param list<string> $modal
     * @param list<string> $lines
     *
     * @return list<string>
     */
    private function renderModal(array $modal, array $lines, int $columns, int $rows): array
    {
        $dimmed = array_map(static fn (string $line) => paint(AnsiUtils::stripAnsiCodes($line), Tone::Line), $lines);

        return Compositor::composite(
            new Layer($dimmed, width: $columns, height: $rows),
            new Layer(
                $modal,
                row: max(0, intdiv($rows - \count($modal), 2)),
                col: max(0, intdiv($columns - AnsiUtils::visibleWidth($modal[0]), 2)),
            ),
        );
    }

    /**
     * @return array{int, int, int}
     */
    private function columnWidths(int $columns): array
    {
        $statusWidth = 0;
        $referenceWidth = 0;
        foreach ($this->entries as $entry) {
            $statusWidth = max($statusWidth, AnsiUtils::visibleWidth($entry->status));
            $referenceWidth = max($referenceWidth, AnsiUtils::visibleWidth($entry->reference));
        }
        $statusWidth = min($statusWidth, self::MAX_STATUS_WIDTH);
        $referenceWidth = min($referenceWidth, self::MAX_REFERENCE_WIDTH);

        // The bar, the icon and the mark of an agent, then the gaps between the columns
        $fixedWidth = 6 + 2 + 2 + self::AGE_WIDTH;
        $titleWidth = $columns - $fixedWidth - $statusWidth - $referenceWidth;
        if ($titleWidth < self::MIN_TITLE_WIDTH) {
            $titleWidth += $statusWidth;
            $statusWidth = 0;
        }

        return [$statusWidth, $referenceWidth, max(0, $titleWidth)];
    }

    private function renderSection(Section $section, int $count, int $columns): string
    {
        $title = " {$section->value} ";
        $rule = str_repeat('─', max(0, $columns - AnsiUtils::visibleWidth($title) - 6));

        return paint($title, $section->tone(), bold: true) . paint((string) $count, Tone::Text) . ' ' . paint($rule, Tone::Line);
    }

    private function renderEntry(Entry $entry, bool $selected, int $columns, int $statusWidth, int $referenceWidth, int $titleWidth): string
    {
        $background = $selected ? Tone::Selection : null;
        $hasAgent = \in_array($entry->id(), $this->activeIds, true);

        $line = paint($selected ? '▌' : ' ', $entry->icon->tone(), $background);
        $line .= paint(' ', Tone::Text, $background);
        $line .= paint($entry->icon->value . ' ', $entry->icon->tone(), $background);
        $line .= paint($hasAgent ? Icon::Agent->value . ' ' : '  ', Icon::Agent->tone(), $background);
        if ($statusWidth > 0) {
            $line .= paint(self::fit($entry->status, $statusWidth) . '  ', $entry->icon->tone(), $background);
        }
        $line .= $this->renderReference($entry->reference, $referenceWidth, $background) . paint('  ', Tone::Text, $background);
        $line .= paint(self::fit($entry->title, $titleWidth), Tone::Text, $background, bold: $selected);
        $line .= paint(str_pad("{$entry->ageInDays} j", self::AGE_WIDTH, ' ', \STR_PAD_LEFT), Tone::Muted, $background);

        $padding = $columns - AnsiUtils::visibleWidth($line);

        return $line . paint(str_repeat(' ', max(0, $padding)), Tone::Text, $background);
    }

    private function renderReference(string $reference, int $width, ?Tone $background): string
    {
        $fitted = self::fit($reference, $width);
        $slash = strrpos($fitted, '/');
        if (false === $slash) {
            return paint($fitted, Tone::Text, $background);
        }

        return paint(substr($fitted, 0, $slash + 1), Tone::Muted, $background) . paint(substr($fitted, $slash + 1), Tone::Text, $background);
    }

    private static function fit(string $text, int $width): string
    {
        return AnsiUtils::truncateToWidth($text, $width, '…', pad: true);
    }
}

/**
 * Boxes to draw over the board, as lines.
 */
final class Modal
{
    private const int KEY_WIDTH = 13;
    private const array KEYS = [
        '↑↓ j k' => 'naviguer',
        'PgUp PgDn' => 'défiler par page',
        'g G' => 'début, fin',
        'Tab Maj+Tab' => 'changer de section',
        'Entrée' => 'Claude, ou un terminal',
        'l' => 'cause de l\'échec de CI',
        'o' => 'ouvrir sur GitHub',
        'd' => 'supprimer une branche',
        'r' => 'rafraîchir',
        '?' => 'fermer cette aide',
        'q' => 'quitter',
    ];
    private const int KEYS_WIDTH = 37;
    private const int MARGIN_WIDTH = 2;
    private const int MIN_CONTENT_WIDTH = 50;

    /**
     * @return list<string>
     */
    public static function help(): array
    {
        $keys = [];
        foreach (self::KEYS as $key => $label) {
            $keys[] = paint(mb_str_pad($key, self::KEY_WIDTH), Tone::Text, Tone::Panel, bold: true) . paint($label, Tone::Muted, Tone::Panel);
        }

        $legend = array_map(
            static fn (Icon $icon) => paint($icon->value . ' ', $icon->tone(), Tone::Panel) . paint($icon->label(), Tone::Muted, Tone::Panel),
            Icon::cases(),
        );

        $rows = [self::columns(paint('Clavier', Tone::Accent, Tone::Panel, bold: true), paint('Légende', Tone::Accent, Tone::Panel, bold: true))];
        for ($index = 0; $index < max(\count($keys), \count($legend)); ++$index) {
            $rows[] = self::columns($keys[$index] ?? '', $legend[$index] ?? '');
        }

        return self::box('Aide', Tone::Accent, $rows);
    }

    /**
     * @return list<string>
     */
    public static function deletion(LocalBranch $branch): array
    {
        $fact = static fn (string $label, string $value) => paint(mb_str_pad($label, self::KEY_WIDTH), Tone::Muted, Tone::Panel) . paint($value, Tone::Text, Tone::Panel, bold: true);

        $rows = [$fact('dépôt', $branch->repository), $fact('branche', $branch->name)];
        if (null !== $branch->worktree) {
            $rows[] = $fact('worktree', str_replace(home(), '~', $branch->worktree));
        }
        if (null !== $branch->lock) {
            $rows[] = paint(mb_str_pad('verrou', self::KEY_WIDTH), Tone::Muted, Tone::Panel) . paint('d\'une session Claude terminée : il sera levé', Tone::Warning, Tone::Panel);
        }
        $rows[] = '';
        $rows[] = paint('y', Tone::Danger, Tone::Panel, bold: true) . paint(' supprimer   ', Tone::Text, Tone::Panel) . paint('une autre touche annule', Tone::Muted, Tone::Panel);

        return self::box($branch->worktree ? 'Supprimer ce worktree et sa branche ?' : 'Supprimer cette branche ?', Tone::Danger, $rows);
    }

    /**
     * @param list<string> $rows
     *
     * @return list<string>
     */
    public static function box(string $title, Tone $tone, array $rows): array
    {
        $contentWidth = max(self::MIN_CONTENT_WIDTH, ...array_map(AnsiUtils::visibleWidth(...), $rows));
        $width = self::MARGIN_WIDTH * 2 + $contentWidth;
        $title = " {$title} ";

        $lines = [paint('╭─', $tone, Tone::Panel) . paint($title, Tone::Text, Tone::Panel, bold: true) . paint(str_repeat('─', $width - mb_strlen($title) - 1) . '╮', $tone, Tone::Panel)];
        foreach (['', ...$rows, ''] as $row) {
            $lines[] = self::row($row, $width, $tone);
        }
        $lines[] = paint('╰' . str_repeat('─', $width) . '╯', $tone, Tone::Panel);

        return $lines;
    }

    private static function columns(string $left, string $right): string
    {
        $gap = self::KEYS_WIDTH - AnsiUtils::visibleWidth($left);

        return $left . paint(str_repeat(' ', max(0, $gap)), Tone::Text, Tone::Panel) . $right;
    }

    private static function row(string $content, int $width, Tone $tone): string
    {
        $margin = paint(str_repeat(' ', self::MARGIN_WIDTH), Tone::Text, Tone::Panel);
        $padding = $width - self::MARGIN_WIDTH - AnsiUtils::visibleWidth($content);

        return paint('│', $tone, Tone::Panel) . $margin . $content . paint(str_repeat(' ', max(0, $padding)), Tone::Text, Tone::Panel) . paint('│', $tone, Tone::Panel);
    }
}

/**
 * The log of a failed CI run, in a box to scroll through.
 */
final class LogViewer
{
    // The borders, the empty rows around the content and the keys at the bottom
    private const int CHROME_ROWS = 7;
    private const int SIDE_COLUMNS = 8;

    private int $offset = 0;
    private bool $positioned = false;
    private int $visibleRows = 1;

    /**
     * @param list<string> $lines
     */
    public function __construct(
        private readonly string $title,
        private readonly array $lines,
    ) {
    }

    public function scroll(int $rows): void
    {
        $this->offset = max(0, min($this->offset + $rows, $this->lastOffset()));
    }

    public function scrollPage(int $direction): void
    {
        $this->scroll($direction * max(1, $this->visibleRows - 1));
    }

    public function scrollToTop(): void
    {
        $this->offset = 0;
    }

    public function scrollToBottom(): void
    {
        $this->offset = $this->lastOffset();
    }

    /**
     * @return list<string>
     */
    public function render(int $columns, int $rows): array
    {
        $this->visibleRows = max(1, $rows - self::CHROME_ROWS);
        if (!$this->positioned) {
            // Opens on the first error, with what led to it above: the end of a
            // log is the cleanup of the job
            $firstError = array_find_key($this->lines, static fn (string $line) => str_contains($line, '##[error]'));
            $this->offset = null === $firstError ? $this->lastOffset() : $firstError - intdiv($this->visibleRows * 2, 3);
            $this->positioned = true;
        }
        // Also after a resize
        $this->scroll(0);

        $width = max(20, $columns - self::SIDE_COLUMNS);
        $content = [];
        foreach (\array_slice($this->lines, $this->offset, $this->visibleRows) as $line) {
            $tone = match (true) {
                str_contains($line, '##[error]') => Tone::Danger,
                str_contains($line, '##[warning]') => Tone::Warning,
                default => Tone::Text,
            };
            $content[] = paint(AnsiUtils::truncateToWidth($line, $width, '…', pad: true), $tone, Tone::Panel);
        }
        $content = array_pad($content, $this->visibleRows, paint(str_repeat(' ', $width), Tone::Text, Tone::Panel));

        $keys = ['↑↓ j k' => 'défiler', 'PgUp PgDn' => 'page', 'g G' => 'début, fin', 'q' => 'fermer'];
        $footer = [];
        foreach ($keys as $key => $label) {
            $footer[] = paint($key, Tone::Text, Tone::Panel, bold: true) . paint(" {$label}", Tone::Muted, Tone::Panel);
        }
        $content[] = '';
        $content[] = implode(paint('   ', Tone::Text, Tone::Panel), $footer);

        $first = [] === $this->lines ? 0 : $this->offset + 1;
        $last = min($this->offset + $this->visibleRows, \count($this->lines));

        return Modal::box("{$this->title} : lignes {$first} à {$last} sur " . \count($this->lines), Tone::Danger, $content);
    }

    private function lastOffset(): int
    {
        return max(0, \count($this->lines) - $this->visibleRows);
    }
}

/**
 * One line that depends on the width of the terminal.
 */
final class LineWidget extends AbstractWidget
{
    /**
     * @param \Closure(int): string $content
     */
    public function __construct(
        private readonly \Closure $content,
    ) {
    }

    public function render(RenderContext $context): array
    {
        $columns = $context->getColumns();

        return [AnsiUtils::truncateToWidth(($this->content)($columns), $columns, '')];
    }
}

enum Section: string
{
    case ToDo = 'À TOI';
    case Reviews = 'REVIEWS DEMANDÉES';
    case AwaitedReplies = 'RÉPONSES ATTENDUES';
    case AssignedIssues = 'ISSUES ASSIGNÉES';
    case Rest = 'LE RESTE';
    case CreatedIssues = 'ISSUES CRÉÉES';
    case Forgotten = 'OUBLIÉ';

    public function tone(): Tone
    {
        return match ($this) {
            self::ToDo => Tone::Danger,
            self::AwaitedReplies, self::Reviews => Tone::Info,
            self::AssignedIssues => Tone::Warning,
            self::Rest => Tone::Success,
            self::CreatedIssues, self::Forgotten => Tone::Muted,
        };
    }

    public function position(): int
    {
        return (int) array_search($this, self::cases(), true);
    }
}

