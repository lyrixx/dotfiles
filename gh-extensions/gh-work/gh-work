final readonly class Snapshot
{
    /**
     * @param list<Entry>        $entries
     * @param list<MergedBranch> $mergedBranches
     */
    private function __construct(
        public array $entries,
        public array $mergedBranches,
        public int $fetchedAt,
    ) {
    }

    /**
     * @param array<string, mixed> $data The response of GitHub
     */
    public static function fromGitHub(array $data, int $fetchedAt): self
    {
        $pullRequests = array_map(Entry::fromPullRequest(...), $data['mine']['nodes']);
        usort($pullRequests, static fn (Entry $a, Entry $b) => [$a->isDraft, $a->ageInDays] <=> [$b->isDraft, $b->ageInDays]);

        return new self(
            [...$pullRequests, ...array_map(Entry::fromReviewRequest(...), $data['requested']['nodes'])],
            array_map(
                static fn (array $node) => new MergedBranch($node['repository']['nameWithOwner'], $node['headRefName'], $node['number'], $node['url'], daysSince($node['updatedAt'])),
                $data['merged']['nodes'],
            ),
            $fetchedAt,
        );
    }

    public function hasOpenPullRequest(MergedBranch $merged): bool
    {
        return [] !== array_filter(
            $this->entries,
            static fn (Entry $entry) => $entry->repository === $merged->repository && $entry->branch === $merged->branch,
        );
    }
}

/**
 * Where to get back to a branch: the last Claude session that worked on it, or
 * else its worktree.
 */
final readonly class Location
{
    public function __construct(
        public string $directory,
        public ?string $worktree = null,
        public ?string $sessionId = null,
    ) {
    }

    public function command(): string
    {
        $directory = str_replace(home(), '~', $this->directory);

        return null === $this->sessionId ? "cd {$directory}" : "cd {$directory} && claude --resume {$this->sessionId}";
    }

    public function isIn(string $directory): bool
    {
        return null !== $this->worktree && str_starts_with("{$directory}/", "{$this->worktree}/");
    }
}

/**
 * The PRs Claude Code recorded in its transcripts. The format is not documented,
 * and a session that only came across a PR has such a link too.
 */
final readonly class PullRequestLinks
{
    /**
     * @param array<string, list<string>> $transcriptsByUrl
     */
    public function __construct(
        private array $transcriptsByUrl,
    ) {
    }

    /**
     * A session of the project comes first: it worked on the PR, while one from
     * elsewhere may only mention it.
     */
    public function latestTranscript(?string $url, string $projectPrefix): ?string
    {
        $transcripts = $this->transcriptsByUrl[$url] ?? [];
        $rank = static fn (string $transcript) => [str_contains($transcript, "/{$projectPrefix}"), filemtime($transcript)];
        usort($transcripts, static fn (string $a, string $b) => $rank($b) <=> $rank($a));

        return $transcripts[0] ?? null;
    }
}

